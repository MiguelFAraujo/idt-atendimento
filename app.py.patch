+# ---------------------------------------------------------------- SSE endpoint for LabPulse
+from flask import Response
+import queue
+
+# Global event queues per session for SSE
+SSE_QUEUES = {}
+
+def sse_push(session, event_type, data):
+    """Push event to SSE queue for a session."""
+    if session not in SSE_QUEUES:
+        SSE_QUEUES[session] = queue.Queue(maxsize=100)
+    try:
+        SSE_QUEUES[session].put_nowait({"type": event_type, "data": data})
+    except queue.Full:
+        pass  # Drop oldest if full
+
+
+@app.get("/api/events/stream")
+def api_events_stream():
+    """Server-Sent Events endpoint for LabPulse real-time updates."""
+    session = _req_session() or (SESSIONS[0] if SESSIONS else "")
+    if not session:
+        return jsonify({"error": "session required"}), 400
+    if session not in SSE_QUEUES:
+        SSE_QUEUES[session] = queue.Queue(maxsize=100)
+    q = SSE_QUEUES[session]
+
+    def event_stream():
+        yield f"data: {json.dumps({'type': 'connected', 'session': session})}\n\n"
+        while True:
+            try:
+                event = q.get(timeout=30)
+                yield f"data: {json.dumps(event)}\n\n"
+            except queue.Empty:
+                yield ": keepalive\n\n"
+            except GeneratorExit:
+                break
+
+    return Response(event_stream(), mimetype="text/event-stream",
+                    headers={"Cache-Control": "no-cache", "Connection": "keep-alive"})
+
+
+# ---------------------------------------------------------------- Bot event emission
+def _emit_bot_event(session, event_type, cid, extra=None):
+    """Emit bot events for SSE."""
+    data = {"session": session, "cid": cid, "timestamp": now_iso()}
+    if extra:
+        data.update(extra)
+    sse_push(session, event_type, data)
+
