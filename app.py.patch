+def _notify_handoff(session, cid, tenant_id, trigger_text, cfg):
+    """Send Telegram notification with inline buttons for handoff."""
+    if not TG_BOT_TOKEN or not TG_CHAT:
+        return
+    try:
+        display = cfg.get("display", session)
+        owner_name = cfg.get("owner_name", "Dono")
+        text = (
+            f"🔁 <b>Handoff solicitado</b>\n"
+            f"Cliente: <b>{display}</b> ({tenant_id})\n"
+            f"Contato: <code>{cid}</code>\n"
+            f"Gatilho: <i>{trigger_text[:100]}</i>\n\n"
+            f"Escolha uma ação:"
+        )
+        keyboard = {
+            "inline_keyboard": [[
+                {"text": "✓ Assumir", "callback_data": f"handoff_assume:{session}:{cid}"},
+                {"text": "✕ Devolver", "callback_data": f"handoff_return:{session}:{cid}"}
+            ]]
+        }
+        url = f"https://api.telegram.org/bot{TG_BOT_TOKEN}/sendMessage"
+        data = {
+            "chat_id": TG_CHAT,
+            "text": text,
+            "parse_mode": "HTML",
+            "reply_markup": json.dumps(keyboard)
+        }
+        req = urllib.request.Request(url, data=json.dumps(data).encode(), headers={"Content-Type": "application/json"})
+        urllib.request.urlopen(req, timeout=10)
